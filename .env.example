# MiniMax API Configuration
# Token Plan Key (from MiniMax dashboard → API Keys)
MINIMAX_API_KEY=your_minimax_api_key_here
# Group ID is required by some MiniMax endpoints (T2A, Voice Clone).
# Find it in your MiniMax dashboard URL: /interface/group/<id>
MINIMAX_GROUP_ID=your_minimax_group_id_here
# Optional: pre-cloned fallback voice_id if account is not verified for live cloning (error 2038)
MINIMAX_FALLBACK_VOICE_ID=

# Supabase Configuration
SUPABASE_PROJECT_ID=your_supabase_project_ref_here
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_or_legacy_anon_key_here
DATABASE_URL=postgresql://postgres:your_url_encoded_password@db.your_project_ref.supabase.co:5432/postgres
SUPABASE_DIRECT_URL=postgresql://postgres:your_url_encoded_password@db.your_project_ref.supabase.co:5432/postgres

# Optional for server-side Supabase Admin API calls.
SUPABASE_SERVICE_ROLE_KEY=

# App Configuration
NEXT_PUBLIC_APP_NAME=Kindred Echo
NODE_ENV=development
